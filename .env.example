# Copy this file to .env and fill in your own Twilio settings.
# Keep .env private. Existing environment variables take precedence.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Required by receive.py: exact public HTTPS URL configured in Twilio.
# Include /webhook and any query string. Update this when the tunnel URL changes.
TWILIO_WEBHOOK_URL=

# Optional outbound menu settings used by send.py.
# Use whatsapp: followed by the full international number, including +.
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
